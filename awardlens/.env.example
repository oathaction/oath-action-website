# AwardLens environment configuration
#
# Copy to .env.local for development:  cp .env.example .env.local
#
# AwardLens runs with NONE of these set. Configuration is graded: each service
# you add upgrades one subsystem, and the app tells you in-product which mode
# each subsystem is in. Nothing here is required to start the app locally.
#
# NEVER commit real credentials. Only NEXT_PUBLIC_* values reach the browser.

# ---------------------------------------------------------------- app ------
# Used for links in emails, Stripe redirects and calendar entries.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Signs session cookies. REQUIRED IN PRODUCTION — the app throws without it.
# Generate one with:  openssl rand -base64 32
AUTH_SECRET=

# ------------------------------------------------------------ storage ------
# Unset  -> local file store (default). Works fully, but it is per-instance and
#           ephemeral on serverless hosts. Fine for development and demos.
# Set    -> Supabase Postgres. All three are required together; see
#           supabase/README.md for migrations and row-level security.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=award-documents

# Overrides where the local file store keeps data. Mostly useful for tests.
# AWARDLENS_DATA_DIR=

# ----------------------------------------------------------------- ai ------
# Unset  -> deterministic rule-based extraction. No external calls, no cost,
#           reproducible output. This is what CI and the demo run on.
# Set    -> live extraction through the Vercel AI Gateway.
#
# Both AI_GATEWAY_API_KEY and AI_MODEL must be present, and
# USE_DETERMINISTIC_AI_FIXTURES must be false, before live mode engages.
#
# Do NOT guess a model id. List the ones your key can actually reach:
#   AI_GATEWAY_API_KEY=... pnpm models:list
# then paste one below, in provider/model form.
AI_GATEWAY_API_KEY=
AI_MODEL=

# Optional: run the completeness critic and evidence auditor on a different
# model so the reviewer is not the system that produced the claim.
AI_CRITIC_MODEL=

# true  -> always use the deterministic extractor, even if a key is present.
# false -> use the live model when a key and model id are configured.
USE_DETERMINISTIC_AI_FIXTURES=true

# ------------------------------------------------------------ billing ------
# true  -> plans are granted without payment and clearly labelled in the UI.
#          Refuses to grant anything in a production build.
# false -> real Stripe Checkout. Requires the keys below.
DEVELOPMENT_BILLING_MODE=true

STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Price IDs created in your Stripe dashboard.
STRIPE_SINGLE_AWARD_PRICE_ID=
STRIPE_SMALL_ORG_PRICE_ID=
STRIPE_TEAM_PRICE_ID=

# -------------------------------------------------------------- email ------
# Unset -> emails are logged to the server console (recipient and subject only,
#          never the body). Sign-in codes are shown on screen in development.
# Set   -> real delivery through Resend.
#
# IMPORTANT: in a PRODUCTION build, sign-in codes are never shown on screen.
# A production deployment without Resend configured cannot be signed into.
RESEND_API_KEY=
EMAIL_FROM="AwardLens <onboarding@resend.dev>"

# --------------------------------------------------------------- cron ------
# Protects /api/cron/reminders. Without it the reminder job refuses to run at
# all, so reminders are scheduled but never delivered.
# Generate one with:  openssl rand -base64 32
CRON_SECRET=

# --------------------------------------------------------------- misc ------
# Acknowledges that a production deployment is intentionally running on the
# ephemeral local store (a demo). Suppresses the durability warning.
# ALLOW_LOCAL_STORE=false
